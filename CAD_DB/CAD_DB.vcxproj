<?xml version="1.0" encoding="utf-8"?>
<!-- v3 worker 工程（V3_PLAN P7：Qt 客户端退役后 Qt-free 化）。
     默认目标 dbcad_worker（几何 worker，服务端权威架构的服务端几何引擎）；
     条件目标：/p:DBCADMeshTests=true → mesh_tests.exe（面片引擎回归门禁）
               /p:DBCADMeshBench=true → mesh_bench.exe（离散化基准）。 -->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{5E33354C-9FD6-4B95-B5CF-924478F548C6}</ProjectGuid>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(MSBuildProjectDirectory)\..\build.local.props" Condition="Exists('$(MSBuildProjectDirectory)\..\build.local.props')" />
  <PropertyGroup>
    <DBCADDepsRoot Condition="'$(DBCADDepsRoot)' == ''">$(MSBuildProjectDirectory)\..\_deps</DBCADDepsRoot>
    <!-- 默认目标 = worker；测试目标显式传入时切换源文件集。 -->
    <DBCADWorker Condition="'$(DBCADMeshTests)' != 'true' And '$(DBCADMeshBench)' != 'true'">true</DBCADWorker>
  </PropertyGroup>
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory);$(DBCADDepsRoot);$(DBCADDepsRoot)\interop\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;WIN32_LEAN_AND_MEAN;SPA_NO_AUTO_LINK;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- ACIS 官方要求：调用方必须用 /MD（即使 Debug 构建）；SPAAcisDsd.dll 自身
           链接 Release 动态 CRT，/MDd 跨边界传递 FILE*/内存会运行时崩溃。
           见 docs/ACIS_2026_MIGRATION.md。 -->
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <!-- ACIS 官方要求：链接 ACIS 的代码必须用 /EHa（异步异常）。 -->
      <ExceptionHandling>Async</ExceptionHandling>
      <TreatWChar_tAsBuiltInType>true</TreatWChar_tAsBuiltInType>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <Optimization>Disabled</Optimization>
      <AdditionalOptions>/utf-8</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(DBCADDepsRoot);$(DBCADDepsRoot)\interop\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>legacy_stdio_definitions.lib;SPAIInterop.lib;SPAIAcis.lib;SPAIopUtilities.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- ACIS 官方要求：栈保留 4MB（深度递归的几何算法）。 -->
      <StackReserveSize>4194304</StackReserveSize>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>DebugFull</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory);$(DBCADDepsRoot);$(DBCADDepsRoot)\interop\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <SDLCheck>false</SDLCheck>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;WIN32_LEAN_AND_MEAN;SPA_NO_AUTO_LINK;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ExceptionHandling>Async</ExceptionHandling>
      <TreatWChar_tAsBuiltInType>true</TreatWChar_tAsBuiltInType>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <DebugInformationFormat>None</DebugInformationFormat>
      <Optimization>MaxSpeed</Optimization>
      <AdditionalOptions>/utf-8</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>legacy_stdio_definitions.lib;SPAIInterop.lib;SPAIAcis.lib;SPAIopUtilities.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(DBCADDepsRoot);$(DBCADDepsRoot)\interop\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <StackReserveSize>4194304</StackReserveSize>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>false</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <Import Project="kernel\acis_link.props" />
  <ItemGroup>
    <ClCompile Include="acis.cpp" />
    <ClCompile Include="common.cpp" />
    <ClCompile Include="kernel\mesh_extractor.cpp" />
    <ClCompile Include="kernel\glb_writer.cpp" />
    <ClCompile Include="worker\main.cpp" Condition="'$(DBCADWorker)' == 'true'" />
    <ClCompile Include="worker\session.cpp" Condition="'$(DBCADWorker)' == 'true'" />
    <ClCompile Include="worker\entity_graph_codec.cpp" Condition="'$(DBCADWorker)' == 'true'" />
    <ClCompile Include="..\scripts\tests\mesh_tests.cpp" Condition="'$(DBCADMeshTests)' == 'true'" />
    <ClCompile Include="..\scripts\tests\mesh_bench.cpp" Condition="'$(DBCADMeshBench)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="acis.hxx" />
    <ClInclude Include="common.hxx" />
    <ClInclude Include="spatial_license.h" />
    <ClInclude Include="kernel\mesh_extractor.h" />
    <ClInclude Include="kernel\glb_writer.h" />
    <ClInclude Include="kernel\model_types.h" />
    <ClInclude Include="worker\session.h" />
    <ClInclude Include="worker\entity_graph_codec.h" />
  </ItemGroup>
  <PropertyGroup>
    <OutDir>$(MSBuildProjectDirectory)\..\x64\$(Configuration)\</OutDir>
    <!-- InterOp 运行时 DLL（STEP 转换器链）随构建暂存到输出目录 -->
    <PostBuildEvent Condition="Exists('$(DBCADDepsRoot)\interop\bin')">
      <Command>xcopy /E /I /Y /D "$(DBCADDepsRoot)\interop\bin\*" "$(MSBuildProjectDirectory)\..\x64\$(Configuration)"</Command>
    </PostBuildEvent>
    <IntDir Condition="'$(DBCADMeshTests)' == 'true'">$(MSBuildProjectDirectory)\..\x64\obj\MeshTests\$(Configuration)\</IntDir>
    <TargetName Condition="'$(DBCADMeshTests)' == 'true'">mesh_tests</TargetName>
    <IntDir Condition="'$(DBCADMeshBench)' == 'true'">$(MSBuildProjectDirectory)\..\x64\obj\MeshBench\$(Configuration)\</IntDir>
    <TargetName Condition="'$(DBCADMeshBench)' == 'true'">mesh_bench</TargetName>
    <IntDir Condition="'$(DBCADWorker)' == 'true' And '$(DBCADMeshTests)' != 'true' And '$(DBCADMeshBench)' != 'true'">$(MSBuildProjectDirectory)\..\x64\obj\Worker\$(Configuration)\</IntDir>
    <TargetName Condition="'$(DBCADWorker)' == 'true' And '$(DBCADMeshTests)' != 'true' And '$(DBCADMeshBench)' != 'true'">dbcad_worker</TargetName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
