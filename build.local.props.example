<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Copy to build.local.props. Point to the MSVC x64 kit, not Qt's parent directory. -->
  <PropertyGroup>
    <QtInstall>C:\Qt\6.8.3\msvc2022_64</QtInstall>
    <DBCADPostgresInclude>C:\vcpkg\installed\x64-windows\include</DBCADPostgresInclude>
    <DBCADDepsRoot>$(MSBuildThisFileDirectory)_deps</DBCADDepsRoot>
  </PropertyGroup>
</Project>
